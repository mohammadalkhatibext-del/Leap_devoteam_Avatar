# Phase 0 — copy to .env and fill in. All of these have free tiers.

# --- TTS candidates -------------------------------------------------------
# Azure Speech: F0 free tier = 0.5M characters/month. Voices: ar-SA-HamedNeural (m),
# ar-SA-ZariyahNeural (f). Region example: uaenorth (closest to KSA) or westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uaenorth

# ElevenLabs: free tier. Pick an Arabic-capable voice in the dashboard, paste its ID.
# ELEVENLABS_MODEL_ID: eleven_multilingual_v2 (quality) | eleven_flash_v2_5 (latency)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Avatar renderers (Phase 0 bake-off) ---------------------------------
# Priority order for a 3-day sprint: Anam first, HeyGen second. Add the others
# only if both fail on Arabic lip-sync.
# Pick a stock avatar in each dashboard and paste its ID (no employee likeness —
# STRATEGY.md §3, avoids the consent/legal risk entirely).
#
# ANAM_AVATAR_ID must be an AVATAR id, not a PERSONA id. Anam has both, they are
# both bare UUIDs, and a persona shows the *same display name* as its avatar — so
# the dashboard gives you no way to tell them apart by eye. Pasting the persona id
# still mints a token (HTTP 200) and only fails later, when the video starts, with
# "Invalid entity ID". Run `npm run check:anam` — it names the mistake and prints
# the avatar ids your key can actually use.
ANAM_API_KEY=
ANAM_AVATAR_ID=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Only if Anam and HeyGen both fail on Arabic lip-sync (~1h to add):
SIMLI_API_KEY=
TAVUS_API_KEY=

# --- Phase 1 -------------------------------------------------------------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
